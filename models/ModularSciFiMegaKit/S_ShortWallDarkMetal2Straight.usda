#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "ShortWall_DarkMetal2_Straight"
    {
        custom string userProperties:blender:object_name = "ShortWall_DarkMetal2_Straight"

        def Mesh "Plane_243" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-1.9999995, -2, 5.292486e-16), (-1.999999, 1.9999999, 2.0018516)]
            int[] faceVertexCounts = [4, 4]
            int[] faceVertexIndices = [1, 0, 2, 3, 5, 3, 2, 4]
            rel material:binding = </root/_materials/MI_Trim_01>
            normal3f[] normals = [(1, 1.192093e-7, -7.105428e-15), (1, 1.192093e-7, -7.105428e-15), (1, 1.1210797e-7, -8.881786e-15), (1, 1.1210797e-7, -8.881786e-15), (1, 1.05006634e-7, -1.0658143e-14), (1, 1.1210797e-7, -8.881786e-15), (1, 1.1210797e-7, -8.881786e-15), (1, 1.05006634e-7, -1.0658143e-14)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-1.999999, -1.9999999, 0.0018517057), (-1.999999, -2, 2.0018516), (-1.9999993, -3.248502e-9, 5.292486e-16), (-1.9999993, 3.227015e-7, 1.9999998), (-1.9999995, 1.9999999, 0.001851054), (-1.9999995, 1.9999999, 2.001851)]
            texCoord2f[] primvars:st = [(0.1390374, 0.087058425), (0.1390374, 0.4806459), (0.5014469, 0.08705835), (0.5014469, 0.4806459), (0.8638562, 0.0870582), (0.86385643, 0.48064584)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [1, 0, 2, 3, 5, 3, 2, 4]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Plane.243"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_Trim_01"
        {
            token outputs:surface.connect = </root/_materials/MI_Trim_01/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Trim_01"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_Trim_01/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_Trim_01/Image_Texture_001.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/T_Trim01Red_D.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_Trim_01/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                asset inputs:file = @./textures/T_Trim01_N.png@
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_Trim_01/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}

