            texCoord2f[] primvars:st = [(0.25924122, 0.9446923), (0.32746783, 0.026097555), (0.5, 0.9446923), (0.74075884, 0.9446923), (0.53450906, 0.026097596), (0.7415503, 0.02609758), (0.24699794, 0.99985), (0.32746783, 0.000558286), (0.5, 0.99985), (0.53450906, 0.0005582748), (0.75300187, 0.99985), (0.7415503, 0.0005582599), (0.25924122, 0.93812096), (0.24699794, 0.9381383), (0.5, 0.93812096), (0.7530021, 0.9381383), (0.74075884, 0.93812096), (0.53450906, 0.026097596), (0.32746783, 0.026097555), (0.7415503, 0.02609758)] (
