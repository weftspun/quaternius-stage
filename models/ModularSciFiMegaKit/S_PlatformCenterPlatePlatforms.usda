#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Platform_CenterPlate"
    {
        custom string userProperties:blender:object_name = "Platform_CenterPlate"

        def Mesh "Plane_184" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-2, -2.0000005, -5.85451e-7), (2, 2, -2.8345937e-7)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4]
            int[] faceVertexIndices = [2, 6, 1, 0, 5, 3, 4, 7, 2, 5, 7, 6, 0, 1, 9, 8, 4, 3, 10, 11]
            rel material:binding = </root/_materials/MI_Trim_01>
            normal3f[] normals = [(4.456145e-14, 7.5497894e-8, 1), (4.4561475e-14, 7.5497894e-8, 1), (4.4561424e-14, 7.5497894e-8, 1), (4.456145e-14, 7.5497894e-8, 1), (-4.7656218e-14, 7.5497894e-8, 1), (-4.7656218e-14, 7.5497894e-8, 1), (-4.7656188e-14, 7.5497894e-8, 1), (-4.7656245e-14, 7.5497894e-8, 1), (4.456145e-14, 7.5497894e-8, 1), (-4.7656218e-14, 7.5497894e-8, 1), (-4.7656245e-14, 7.5497894e-8, 1), (4.4561475e-14, 7.5497894e-8, 1), (4.456145e-14, 7.5497894e-8, 1), (4.4561424e-14, 7.5497894e-8, 1), (0, 7.549791e-8, 1), (0, 7.549791e-8, 1), (-4.7656188e-14, 7.5497894e-8, 1), (-4.7656218e-14, 7.5497894e-8, 1), (0, 7.549791e-8, 1), (0, 7.549791e-8, 1)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-1.4000001, -2.0000005, -2.8345937e-7), (-1.4000001, 2, -5.85451e-7), (-1.0810955, -2.0000005, -2.8345937e-7), (1.4000001, -2.0000005, -2.8345937e-7), (1.4000001, 2, -5.85451e-7), (1.0810955, -2.0000005, -2.8345937e-7), (-1.0810955, 1.9999994, -5.85451e-7), (1.0810955, 1.9999994, -5.85451e-7), (-2, -2.0000005, -2.8345937e-7), (-2, 2, -5.85451e-7), (2, -2.0000005, -2.8345937e-7), (2, 2, -5.85451e-7)]
            texCoord2f[] primvars:st = [(0.9964922, 0.59051776), (1, 0.7538484), (0.0035077631, 0.5905179), (0, 0.7538485), (0.9964922, 0.6591564), (1, 0.067410484), (0.9964922, 0.59051776), (1, 0.49172702), (0.0035077631, 0.5905179), (-2.9802322e-8, 0.49172714), (0.9964922, 0.6591564), (1.0000001, 0.4988082), (0.0035077631, 0.65915644), (-2.9802322e-8, 0.06741068), (0.0035077631, 0.65915644), (2.9802322e-8, 0.49880826), (1, 0.49172702), (0, 0.49172714), (1, 0.7538484), (2.9802322e-8, 0.7538484)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [4, 12, 2, 0, 10, 6, 8, 14, 5, 11, 15, 13, 1, 3, 17, 16, 9, 7, 18, 19]
            uniform token subdivisionScheme = "none"
            uniform token subsetFamily:materialBind:familyType = "nonOverlapping"
            custom string userProperties:blender:data_name = "Plane.184"

            def GeomSubset "MI_Trim_01" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform token elementType = "face"
                uniform token familyName = "materialBind"
                int[] indices = [0, 1, 2]
                rel material:binding = </root/_materials/MI_Trim_01>
            }

            def GeomSubset "MI_Trim_02" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform token elementType = "face"
                uniform token familyName = "materialBind"
                int[] indices = [3, 4]
                rel material:binding = </root/_materials/MI_Trim_02>
            }
        }
    }

    def Scope "_materials"
    {
        def Material "MI_Trim_01"
        {
            token outputs:surface.connect = </root/_materials/MI_Trim_01/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Trim_01"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_Trim_01/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_Trim_01/Image_Texture_001.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/T_Trim01Red_D.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_Trim_01/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                asset inputs:file = @./textures/T_Trim01_N.png@
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_Trim_01/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "MI_Trim_02"
        {
            token outputs:surface.connect = </root/_materials/MI_Trim_02/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Trim_02"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_Trim_02/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/T_Trim02Red_D.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_Trim_02/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }
    }
}

