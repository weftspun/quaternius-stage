#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "ShortWall_Metal2_Straight"
    {
        custom string userProperties:blender:object_name = "ShortWall_Metal2_Straight"

        def Mesh "Plane_227" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-1.9999995, -1.9999999, 0.0018509029), (-1.999999, 1.9999999, 2.0018518)]
            int[] faceVertexCounts = [4, 4]
            int[] faceVertexIndices = [5, 3, 2, 4, 1, 0, 2, 3]
            rel material:binding = </root/_materials/MI_Trim_01>
            normal3f[] normals = [(1, 1.7875585e-7, -2.8421716e-14), (1, 1.1918025e-7, -1.6875393e-14), (1, 1.1918025e-7, -1.6875393e-14), (1, 1.7875585e-7, -2.8421716e-14), (1, 5.9604645e-8, -5.3290705e-15), (1, 5.9604645e-8, -5.3290705e-15), (1, 1.1918025e-7, -1.6875393e-14), (1, 1.1918025e-7, -1.6875393e-14)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-1.999999, -1.9999998, 0.0018518567), (-1.999999, -1.9999999, 2.0018518), (-1.9999992, -3.1087337e-9, 0.0018513799), (-1.9999992, 4.7383708e-7, 2.0018513), (-1.9999995, 1.9999998, 0.0018509029), (-1.9999995, 1.9999999, 2.0018508)]
            texCoord2f[] primvars:st = [(0.1390374, 0.6640981), (0.1390374, 1.0005264), (0.5014469, 0.664098), (0.5014469, 1.0005264), (0.8638562, 0.6640978), (0.86385643, 1.0005264)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [5, 3, 2, 4, 1, 0, 2, 3]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Plane.227"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_Trim_01"
        {
            token outputs:surface.connect = </root/_materials/MI_Trim_01/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Trim_01"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_Trim_01/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_Trim_01/Image_Texture_001.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_Trim_01/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_Trim_01/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}

