#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Decal_Dashes"
    {
        custom string userProperties:blender:object_name = "Decal_Dashes"

        def Mesh "Plane_041" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-0.53672814, -0.16578993, -1.2516815e-8), (0.53672814, 0.16579024, 1.2516791e-8)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [3, 2, 0, 1]
            rel material:binding = </root/_materials/M_Decal_White>
            normal3f[] normals = [(-4.679673e-16, 7.54979e-8, 1), (-4.679673e-16, 7.54979e-8, 1), (-4.679673e-16, 7.54979e-8, 1), (-4.679673e-16, 7.54979e-8, 1)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-0.5367233, 0.16578895, -1.2516717e-8), (-0.53672814, -0.16578993, 1.2516791e-8), (0.53672296, 0.16579024, -1.2516815e-8), (0.53672814, -0.16578977, 1.251678e-8)]
            texCoord2f[] primvars:st = [(0.7764701, 0.6983121), (0.7764693, 0.6369388), (0.97515863, 0.6983122), (0.97515965, 0.63693875)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [3, 2, 0, 1]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Plane.041"
        }
    }

    def Scope "_materials"
    {
        def Material "M_Decal_White"
        {
            token outputs:surface.connect = </root/_materials/M_Decal_White/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "M_Decal_White"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/M_Decal_White/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/T_Decals_D.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/M_Decal_White/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }
    }
}

