                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [4, 5, 2, 0, 1, 3, 7, 6, 8, 14, 10, 9, 13, 12, 11, 15]
            texCoord2f[] primvars:UVMap_1 = [(0.7945551, 0.27508932), (0.7945551, 0.27508932), (0.7945551, 0.27508938), (0.7945551, 0.27508938), (0.7945551, 0.27508932), (0.7945551, 0.27508932), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5)] (
                interpolation = "faceVarying"
