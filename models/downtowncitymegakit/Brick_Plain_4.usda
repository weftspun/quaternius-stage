            point3f[] points = [(-1, 1.986163e-8, 2), (1, 1.986163e-8, 2), (-1, -4.3711385e-8, 3.3001177e-15), (1, -4.371139e-8, 3.3001179e-15), (-1, 1.7085742e-7, 4), (1, 1.7085742e-7, 4), (-1, 0.20000009, -1.5099587e-8), (1, 0.20000009, -1.5099587e-8), (1, 0.20000024, 2), (1, 0.20000039, 3.9999995), (-1, 0.20000039, 4.0000005), (-1, 0.20000024, 2)]
