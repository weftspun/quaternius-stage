    {
        def Material "Wood_Dark"
        {
            token outputs:surface.connect = </root/_materials/Wood_Dark/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Wood_Dark"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.05494705, 0.040438917, 0.03151464)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.6900348
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "Cushin"
        {
            token outputs:surface.connect = </root/_materials/Cushin/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Cushin"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
