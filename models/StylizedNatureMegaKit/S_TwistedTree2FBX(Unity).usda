                color3f inputs:diffuseColor.connect = </root/_materials/Bark_TwistedTree/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/Bark_TwistedTree/Image_Texture_001.outputs:rgb>
                float inputs:opacity = 1
