            texCoord2f[] primvars:st = [(0.50817555, 0.41829544), (0.23537675, 0.6630843), (0.23645294, 0.41509902), (0.7817689, 0.41829553), (0.23537675, 0.49379048), (0.77731186, 0.663646), (0.23537675, 0.41442546), (0.7817689, 0.49420506), (0.5047523, 0.6630843), (0.23465967, 0.41829544), (0.50232613, 0.41509902), (0.5047523, 0.49379048), (0.50619876, 0.4182955), (0.5108615, 0.663646), (0.5047523, 0.41442546), (0.50619876, 0.4855923), (0.23645294, 0.4889322), (0.50817555, 0.48869088), (0.77731186, 0.49394673), (0.23645294, 0.49394673), (0.50817555, 0.49420497), (0.5108615, 0.49394673), (0.23930931, 0.48559225), (0.50232613, 0.49394673), (0.23465967, 0.48007813), (0.50232613, 0.4889322), (0.23537675, 0.4229524), (0.7817689, 0.4869747)] (
