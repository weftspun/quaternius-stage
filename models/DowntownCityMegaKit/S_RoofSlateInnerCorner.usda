                interpolation = "faceVarying"
            )
            point3f[] points = [(0, 0, 0), (-5.6425995e-7, -0.99999976, 3), (-0.0000010093106, -1.9999998, 3.0000002), (-2.0000012, -1.9999989, 3.0000002), (-0.0000010093106, -1.9999998, 2.8000002), (-2.0000012, -1.9999989, 2.8000002), (-1.0000006, -0.99999934, 3), (-1, 6.7154434e-7, 3), (-2, 0.0000012358043, 3), (-2, 0.0000012207047, 2.8)]
            texCoord2f[] primvars:st = [(0, 0), (0, 1), (0, 1.375), (0.72497094, 0.8987167), (0, 1), (0.27502906, 0.89871675), (1, 1), (0.72497094, 0.8537224), (0.275029, 0.8537224), (0.5, 1), (0.5, 1.375), (0, 1), (0, 1.375), (0.72497094, 0.8987167), (0, 1), (0.72497094, 0.8537224)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [3, 5, 8, 7, 0, 9, 1, 2, 10, 6, 4, 13, 15, 8, 5, 0, 11, 9, 12, 14, 6, 10]
            texCoord2f[] primvars:UVMap_1 = [(0.25122362, 0.1954727), (0.25122362, 0.6788844), (0.25122362, 0.86016375), (0.25122362, 0.6788844), (0.7346353, 0.6788844), (0.25122362, 0.6788844), (0.7346353, 0.6788844), (0.49292946, 0.6788844), (0.49292946, 0.86016375), (0.25122362, 0.6788844), (0.25122362, 0.86016375), (0.25122362, 0.6788844), (0.25122362, 0.6788844)] (
                interpolation = "faceVarying"
            )
            int[] primvars:UVMap_1:indices = [3, 4, 6, 5, 0, 7, 1, 2, 8, 4, 3, 11, 12, 6, 4, 0, 9, 7, 10, 11, 4, 8]
            uniform token subdivisionScheme = "none"
            uniform token subsetFamily:materialBind:familyType = "nonOverlapping"
            custom string userProperties:blender:data_name = "Plane.004"

            def GeomSubset "MI_Roof_Slate" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform token elementType = "face"
                uniform token familyName = "materialBind"
                int[] indices = [1, 2, 4, 5]
                rel material:binding = </root/_materials/MI_Roof_Slate>
