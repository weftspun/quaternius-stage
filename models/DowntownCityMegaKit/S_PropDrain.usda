#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Prop_Drain"
    {
        custom string userProperties:blender:object_name = "Prop_Drain"

        def Mesh "Cube_173" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-0.29259434, -0.29259434, -2.2090257e-8), (0.29259434, 0.29259434, 0.040405985)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 3, 2, 2, 3, 7, 6, 6, 7, 5, 4, 4, 5, 1, 0, 7, 3, 1, 5]
            rel material:binding = </root/_materials/MI_Ornaments>
            normal3f[] normals = [(-0.9593657, 3.8570338e-8, 0.2821654), (-0.9593657, 3.8570338e-8, 0.2821654), (-0.9593657, 3.8570338e-8, 0.2821654), (-0.9593657, 3.8570338e-8, 0.2821654), (0, 0.9593659, 0.28216475), (0, 0.9593659, 0.28216475), (0, 0.9593659, 0.28216475), (0, 0.9593659, 0.28216475), (0.9593657, 3.8570338e-8, 0.2821654), (0.9593657, 3.8570338e-8, 0.2821654), (0.9593657, 3.8570338e-8, 0.2821654), (0.9593657, 3.8570338e-8, 0.2821654), (0, -0.9593659, 0.28216475), (0, -0.9593659, 0.28216475), (0, -0.9593659, 0.28216475), (0, -0.9593659, 0.28216475), (0, 7.962566e-8, 1), (0, 7.962566e-8, 1), (0, 7.962566e-8, 1), (0, 7.962566e-8, 1)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-0.29259434, -0.29259434, 2.2090257e-8), (-0.28071028, -0.28071028, 0.040405985), (-0.29259434, 0.29259434, -2.2090257e-8), (-0.28071028, 0.28071028, 0.04040594), (0.29259434, -0.29259434, 2.2090257e-8), (0.28071028, -0.28071028, 0.040405985), (0.29259434, 0.29259434, -2.2090257e-8), (0.28071028, 0.28071028, 0.04040594)]
            texCoord2f[] primvars:st = [(0.6312663, 0.0026129931), (0.6378721, 0.008992642), (0.6312663, 0.19748102), (0.6378721, 0.19110125), (0.83304316, 0.0026129931), (0.82643723, 0.008992642), (0.83304316, 0.19748102), (0.82643723, 0.19110125)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [0, 1, 3, 2, 2, 3, 7, 6, 6, 7, 5, 4, 4, 5, 1, 0, 7, 3, 1, 5]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Cube.173"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_Ornaments"
        {
            token outputs:surface.connect = </root/_materials/MI_Ornaments/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Ornaments"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_Ornaments/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_Ornaments/Image_Texture_001.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/T_Ornaments_D.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_Ornaments/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                asset inputs:file = @./textures/T_Ornaments_N.png@
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_Ornaments/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}

