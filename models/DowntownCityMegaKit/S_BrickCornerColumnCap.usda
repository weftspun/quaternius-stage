                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_RedBrick_Pale/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
