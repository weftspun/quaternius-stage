                float4 inputs:bias = (-1, -1, -1, -1)
                asset inputs:file = @./textures/T_RoofSlate_N.png@
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_Roof_Slate/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
