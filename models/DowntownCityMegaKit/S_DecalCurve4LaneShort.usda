                asset inputs:file = @./textures/T_StreetDecals_D.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_StreetDecals/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
