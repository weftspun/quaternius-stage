    def Scope "_materials"
    {
        def Material "MI_RedBrick"
        {
            token outputs:surface.connect = </root/_materials/MI_RedBrick/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_RedBrick"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_RedBrick/Image_Texture.outputs:rgb>
