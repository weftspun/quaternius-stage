{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Metal_FirstFloor_Wall_1"
    {
        custom string userProperties:blender:object_name = "Metal_FirstFloor_Wall_1"

        def Mesh "Cube_002" (
