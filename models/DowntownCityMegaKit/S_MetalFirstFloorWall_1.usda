            texCoord2f[] primvars:UVMap_1 = [(0.12176088, 0.32154432), (0.47992125, 0.32038698), (0.12181725, 0.33627605), (0.47993344, 0.33527744), (0.12094586, 0.24981247), (0.12176088, 0.32154432), (0.48002425, 0.24781325), (0.47992125, 0.32038698), (0.12181725, 0.33627605), (0.47993344, 0.33527744), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5)] (
