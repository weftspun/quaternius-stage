#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Roof_2x2_90Angle_Center"
    {
        custom string userProperties:blender:object_name = "Roof_2x2_90Angle_Center"

        def Mesh "Plane_068" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-1, -0.6, -0.2000001), (1, 1, -0.19999999)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [2, 3, 1, 0]
            rel material:binding = </root/_materials/MI_Asphalt>
            normal3f[] normals = [(0, 7.4505806e-8, 1), (0, 7.4505806e-8, 1), (0, 7.4505806e-8, 1), (0, 7.4505806e-8, 1)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-1, 1, -0.2000001), (1, 1, -0.2000001), (-1, -0.6, -0.19999999), (1, -0.6, -0.19999999)]
            texCoord2f[] primvars:st = [(0, 1), (1, 1), (0, 0.19999999), (1, 0.19999999)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [2, 3, 1, 0]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Plane.068"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_Asphalt"
        {
            token outputs:surface.connect = </root/_materials/MI_Asphalt/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Asphalt"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_Asphalt/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_Asphalt/Image_Texture_001.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/T_ConcreteAsphalt_D.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_Asphalt/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                asset inputs:file = @./textures/T_Concrete_N.png@
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_Asphalt/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}

