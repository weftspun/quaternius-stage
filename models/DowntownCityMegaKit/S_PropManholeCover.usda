            int[] primvars:st:indices = [0, 2, 5, 3, 3, 5, 8, 6, 6, 8, 11, 9, 9, 11, 14, 12, 12, 14, 17, 15, 15, 17, 20, 18, 18, 20, 23, 21, 21, 23, 26, 24, 24, 26, 29, 27, 27, 29, 32, 30, 30, 32, 35, 33, 33, 35, 38, 36, 36, 38, 41, 39, 39, 41, 44, 42, 42, 44, 47, 45, 45, 47, 50, 48, 48, 50, 53, 51, 51, 53, 56, 54, 54, 56, 59, 57, 57, 59, 62, 60, 60, 62, 65, 63, 63, 65, 68, 66, 5, 2, 71, 68, 65, 62, 59, 56, 53, 50, 47, 44, 41, 38, 35, 32, 29, 26, 23, 20, 17, 14, 11, 8, 66, 68, 71, 69, 69, 71, 2, 0, 28, 31, 82, 81, 43, 46, 87, 86, 58, 61, 92, 91, 7, 10, 75, 74, 22, 25, 80, 79, 1, 4, 73, 72, 37, 40, 85, 84, 52, 55, 90, 89, 67, 70, 95, 94, 16, 19, 78, 77, 31, 34, 83, 82, 46, 49, 88, 87, 61, 64, 93, 92, 10, 13, 76, 75, 25, 28, 81, 80, 40, 43, 86, 85, 55, 58, 91, 90, 70, 1, 72, 95, 4, 7, 74, 73, 19, 22, 79, 78, 34, 37, 84, 83, 49, 52, 89, 88, 64, 67, 94, 93, 13, 16, 77, 76]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Cylinder.001"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_Ornaments"
        {
            token outputs:surface.connect = </root/_materials/MI_Ornaments/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Ornaments"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_Ornaments/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_Ornaments/Image_Texture_001.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_Ornaments/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_Ornaments/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}

