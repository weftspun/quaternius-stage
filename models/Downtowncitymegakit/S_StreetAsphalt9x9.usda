#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Street_Asphalt_9x9"
    {
        custom string userProperties:blender:object_name = "Street_Asphalt_9x9"

        def Mesh "Plane_024" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-9, -2.4974327e-7, -0.15000069), (0, 9, -0.15)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 3, 2]
            rel material:binding = </root/_materials/MI_Asphalt>
            normal3f[] normals = [(0, 7.616149e-8, 1), (0, 7.616149e-8, 1), (0, 7.616149e-8, 1), (0, 7.616149e-8, 1)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(0, -1.1324685e-8, -0.15), (0, 9, -0.15000069), (-9, -2.4974327e-7, -0.15), (-9, 9, -0.15000069)]
            texCoord2f[] primvars:st = [(-8.742277e-8, -1.9999998), (2.9999995, -2), (4.371139e-8, 1), (2.9999995, 0.99999946)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [0, 1, 3, 2]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Plane.024"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_Asphalt"
        {
            token outputs:surface.connect = </root/_materials/MI_Asphalt/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Asphalt"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_Asphalt/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_Asphalt/Image_Texture_001.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_Asphalt/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_Asphalt/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}

