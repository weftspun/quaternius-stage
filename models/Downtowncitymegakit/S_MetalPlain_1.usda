            int[] primvars:st:indices = [4, 5, 2, 0, 1, 3, 6, 7, 8, 11, 10, 9]
            texCoord2f[] primvars:UVMap_1 = [(0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5), (0.5, 0.5)] (
