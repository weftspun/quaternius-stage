        def Material "MI_Trim_MetalConcrete"
        {
            token outputs:surface.connect = </root/_materials/MI_Trim_MetalConcrete/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Trim_MetalConcrete"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_Trim_MetalConcrete/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
