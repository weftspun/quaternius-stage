            rel material:binding = </root/_materials/Bush_Leaves>
            normal3f[] normals = [(0.010835964, -0.3485505, 0.93722737), (0.22732705, -0.66890585, 0.70773387), (0.4479756, -0.31286937, 0.83751446), (0.010835964, -0.3485505, 0.93722737), (-0.21052015, -0.6694503, 0.71240276), (0.22732705, -0.66890585, 0.70773387), (0.010835964, -0.3485505, 0.93722737), (-0.42831385, -0.314032, 0.84730816), (-0.21052015, -0.6694503, 0.71240276), (0.010835964, -0.3485505, 0.93722737), (-0.20800152, 0.04232435, 0.97721237), (-0.42831385, -0.314032, 0.84730816), (0.010835964, -0.3485505, 0.93722737), (0.23014228, 0.042653807, 0.97222173), (-0.20800152, 0.04232435, 0.97721237), (0.010835964, -0.3485505, 0.93722737), (0.4479756, -0.31286937, 0.83751446), (0.23014228, 0.042653807, 0.97222173)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-0.0012999834, -0.0010289326, -0.00430569), (-0.23572235, -0.041237712, 0.10606302), (-0.1172169, 0.15017742, 0.17583808), (0.1184188, 0.15055558, 0.1735172), (0.2356354, -0.04088293, 0.100694224), (0.11712988, -0.23229797, 0.030918896), (-0.11854912, -0.23247547, 0.033603415)]
            texCoord2f[] primvars:st = [(0.19550931, 0.8015416), (0.2985573, 0.62305725), (0.092461325, 0.62305725), (-0.010586711, 0.8015416), (0.09246131, 0.980026), (0.2985573, 0.980026), (0.4016053, 0.80154175)] (
