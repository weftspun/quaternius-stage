    def Xform "Petals_3"
    {
        custom string userProperties:blender:object_name = "Petals_3"

        def Mesh "Plane_014" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-0.23572235, -0.23247547, -0.00430569), (0.2356354, 0.15055558, 0.17583808)]
