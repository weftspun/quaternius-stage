    def Scope "_materials"
    {
        def Material "White"
        {
            token outputs:surface.connect = </root/_materials/White/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "White"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.4479754, 0.44329065, 0.4294085)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.6900348
                float inputs:specular = 0.5
                token outputs:surface
            }
        }

        def Material "Metal"
        {
            token outputs:surface.connect = </root/_materials/Metal/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Metal"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.14730893, 0.11338982, 0.09997833)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.6900348
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }
