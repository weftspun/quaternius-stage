    def Scope "_materials"
    {
        def Material "Grey2"
        {
            token outputs:surface.connect = </root/_materials/Grey2/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Grey2"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.14239658, 0.14239658, 0.14239658)
                float inputs:ior = 1.5
                float inputs:metallic = 0
