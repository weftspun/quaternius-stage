#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Corner_Exterior_TopOnly"
    {
        custom string userProperties:blender:object_name = "Corner_Exterior_TopOnly"

        def Mesh "Cube_022" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-0.09224499, -0.09224539, 2.8832355), (0.0005377127, 0.00053764577, 3.1167626)]
            int[] faceVertexCounts = [3, 3, 4, 3, 3, 4]
            int[] faceVertexIndices = [1, 0, 2, 1, 2, 6, 7, 5, 6, 2, 4, 5, 7, 4, 7, 3, 3, 7, 2, 0]
            rel material:binding = </root/_materials/MI_WoodTrim>
            normal3f[] normals = [(0.000006924035, 0, -1), (0.0000069240314, 0, -1), (0.0000069240355, 0, -1), (0.000006924035, 0, -1), (0.0000069240355, 0, -1), (0.000006924039, 0, -1), (-0.7071088, -0.70710474, 7.2605175e-8), (-0.70710915, -0.70710444, 1.1463974e-7), (-0.70710915, -0.70710444, 1.1463974e-7), (-0.7071088, -0.70710474, 7.2605175e-8), (-0.000003462009, 0, 1), (0, 0, 1), (-0.0000034620243, 0, 1), (-0.000003462009, 0, 1), (-0.0000034620243, 0, 1), (-0.000006924033, 0, 1), (-0.70710856, -0.7071049, 3.0570614e-8), (-0.7071088, -0.70710474, 7.2605175e-8), (-0.7071088, -0.70710474, 7.2605175e-8), (-0.70710856, -0.7071049, 3.0570614e-8)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-9.353152e-8, -0.09224539, 2.8832355), (0.0005377127, 0.0005376452, 2.8832355), (-0.046122544, -0.046122663, 2.8832355), (-9.353152e-8, -0.092245385, 3.1167626), (0.0005377127, 0.00053764577, 3.1167626), (-0.09224499, 6.165408e-8, 3.1167626), (-0.09224499, -1.4888318e-8, 2.8832355), (-0.046122544, -0.046122663, 3.1167626)]
            texCoord2f[] primvars:st = [(0.00014872153, 0.69258726), (0, 0.88273686), (0.00014872153, 0.74795157), (0.028593604, 0.7193202), (0.04598558, 0.8827368), (0.00014872153, 0.69258726), (0, 0.99616945), (0.00005185639, 0.74804854), (0, 0.99616915), (0.000051860115, 0.6925596), (0.000051860115, 0.6925596), (0, 0.8827367), (0.02849695, 0.71927184), (0.04598558, 0.9961693)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [2, 0, 3, 2, 3, 10, 13, 8, 11, 4, 7, 9, 12, 7, 12, 5, 6, 13, 4, 1]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Cube.022"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_WoodTrim"
        {
            token outputs:surface.connect = </root/_materials/MI_WoodTrim/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_WoodTrim"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_WoodTrim/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_WoodTrim/Image_Texture_002.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness.connect = </root/_materials/MI_WoodTrim/Image_Texture_001.outputs:r>
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_WoodTrim/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_WoodTrim/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "Image_Texture_002"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_WoodTrim/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}

