#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Corner_Interior_Small"
    {
        custom string userProperties:blender:object_name = "Corner_Interior_Small"

        def Mesh "Cube_091" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(0.19491267, 0.18017994, -1.5052728e-7), (0.4050871, 0.41982007, 2.9999998)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 2, 3, 1, 6, 4, 5, 7, 2, 6, 7, 3, 7, 5, 1, 3, 2, 0, 4, 6, 1, 5, 4, 0]
            rel material:binding = </root/_materials/MI_WoodTrim>
            normal3f[] normals = [(0, 0, 0.99999994), (0, 0, 0.99999994), (0, 0, 0.99999994), (0, 0, 0.99999994), (-2.9802325e-7, -3.526909e-14, -1), (-2.9802325e-7, -3.526909e-14, -1), (-2.9802325e-7, -3.526909e-14, -1), (-2.9802325e-7, -3.526909e-14, -1), (-4.5076735e-14, 1, -7.605239e-8), (-4.5076735e-14, 1, -7.605239e-8), (-4.5076735e-14, 1, -7.605239e-8), (-4.5076735e-14, 1, -7.605239e-8), (-1, 0, 6.059805e-7), (-1, 0, 6.059805e-7), (-1, 0, 6.059805e-7), (-1, 0, 6.059805e-7), (1, 1.6581726e-7, -4.768372e-7), (1, 1.6581726e-7, -4.768372e-7), (1, 1.6581726e-7, -4.768372e-7), (1, 1.6581726e-7, -4.768372e-7), (4.5076725e-14, -1, 6.978206e-8), (4.5076725e-14, -1, 6.978206e-8), (4.5076725e-14, -1, 6.978206e-8), (4.5076725e-14, -1, 6.978206e-8)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(0.4050871, 0.18018018, 2.9999998), (0.19491449, 0.18018016, 2.9999998), (0.40508705, 0.41982007, 2.9999998), (0.19491449, 0.41982007, 2.9999998), (0.40508568, 0.18017994, -1.5052728e-7), (0.19491267, 0.18017995, -8.789087e-8), (0.40508562, 0.41981983, -1.5052728e-7), (0.19491267, 0.41981983, -8.789087e-8)]
            texCoord2f[] primvars:st = [(0.33250102, 0.21301872), (0, 0.75754845), (1, 0.99616915), (0.33250102, 0.3735697), (0, 0.75754845), (1, 0.8827367), (0.49032265, 0.21301872), (1, 0.8827367), (0, 0.867594), (0.49032265, 0.3735697), (1, 0.99616915), (0, 0.867594), (0.33250102, 0.21301872), (1, 0.75754845), (0, 0.99616945), (0.33250102, 0.3735697), (1, 0.75754845), (0, 0.88273686), (0.49032265, 0.21301872), (0, 0.88273686), (1, 0.867594), (0.49032265, 0.3735697), (0, 0.99616945), (1, 0.867594)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [0, 6, 9, 3, 18, 12, 15, 21, 7, 19, 22, 10, 23, 16, 4, 11, 8, 1, 13, 20, 5, 17, 14, 2]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Cube.091"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_WoodTrim"
        {
            token outputs:surface.connect = </root/_materials/MI_WoodTrim/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_WoodTrim"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_WoodTrim/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_WoodTrim/Image_Texture_002.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness.connect = </root/_materials/MI_WoodTrim/Image_Texture_001.outputs:r>
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_WoodTrim/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_WoodTrim/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "Image_Texture_002"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_WoodTrim/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}

