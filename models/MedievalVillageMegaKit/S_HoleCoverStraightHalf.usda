#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "HoleCover_StraightHalf"
    {
        custom string userProperties:blender:object_name = "HoleCover_StraightHalf"

        def Mesh "Cube_081" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-0.5, 0.88017994, -0.10508604), (0.5, 1.11982, 0.105087645)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4]
            int[] faceVertexIndices = [2, 0, 1, 3, 3, 1, 6, 5, 4, 7, 0, 2, 7, 6, 1, 0, 5, 4, 2, 3]
            rel material:binding = </root/_materials/MI_WoodTrim>
            normal3f[] normals = [(-1, -2.958587e-7, 2.1269857e-7), (-1, -2.958587e-7, 2.1269857e-7), (-1, -2.958587e-7, 2.1269857e-7), (-1, -2.958587e-7, 2.1269857e-7), (-7.772688e-9, -1.8654448e-7, 1), (-7.772688e-9, -1.8654448e-7, 1), (-7.772688e-9, -1.8654448e-7, 1), (-7.772688e-9, -1.8654448e-7, 1), (-3.3422563e-7, 0.0000017566277, -1), (-3.3422563e-7, 0.0000017566277, -1), (-3.3422563e-7, 0.0000017566277, -1), (-3.3422563e-7, 0.0000017566277, -1), (2.9802322e-7, -1, -3.1757827e-7), (2.9802322e-7, -1, -3.1757827e-7), (2.9802322e-7, -1, -3.1757827e-7), (2.9802322e-7, -1, -3.1757827e-7), (-2.384186e-7, 1, 4.0840683e-7), (-2.384186e-7, 1, 4.0840683e-7), (-2.384186e-7, 1, 4.0840683e-7), (-2.384186e-7, 1, 4.0840683e-7)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-0.49999997, 0.88017994, -0.105085395), (-0.4999999, 0.88017994, 0.1050876), (-0.5, 1.1198198, -0.1050853), (-0.49999997, 1.1198198, 0.105087645), (0.5, 1.11982, -0.1050853), (0.49999985, 1.11982, 0.105087645), (0.49999997, 0.88018024, 0.1050876), (0.5, 0.88018024, -0.10508604)]
            texCoord2f[] primvars:st = [(0.33250102, 0.21301872), (1, 0.75754845), (0, 0.99616945), (0.33250102, 0.3735697), (1, 0.75754845), (0, 0.88273686), (0.49032265, 0.21301872), (1, 0.867594), (0, 0.88273686), (0.49032265, 0.3735697), (1, 0.867594), (0, 0.99616945), (-0.0018010437, 0.867594), (1.001801, 0.8827368), (-0.0018010437, 0.867594), (1.001801, 0.9961693), (-0.0018010437, 0.75754845), (1.001801, 0.8827368), (-0.0018010437, 0.75754845), (1.001801, 0.9961693)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [6, 0, 3, 9, 10, 4, 16, 14, 12, 18, 1, 7, 19, 17, 5, 2, 15, 13, 8, 11]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Cube.081"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_WoodTrim"
        {
            token outputs:surface.connect = </root/_materials/MI_WoodTrim/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_WoodTrim"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/MI_WoodTrim/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/MI_WoodTrim/Image_Texture_002.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness.connect = </root/_materials/MI_WoodTrim/Image_Texture_001.outputs:r>
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/T_WoodTrim_D.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/MI_WoodTrim/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/T_WoodTrim_R.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_WoodTrim/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "Image_Texture_002"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                asset inputs:file = @./textures/T_WoodTrim_N.png@
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/MI_WoodTrim/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }
}

