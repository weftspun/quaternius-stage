)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Floor_WoodLight_OverhangCorner"
    {
        custom string userProperties:blender:object_name = "Floor_WoodLight_OverhangCorner"

        def Mesh "Plane_070" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
