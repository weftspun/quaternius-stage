#usda 1.0
(
    defaultPrim = "root"
    doc = "Blender v5.1.2"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "root" (
    customData = {
        dictionary Blender = {
            bool generated = 1
        }
    }
)
{
    float3 xformOp:rotateXYZ = (-90, -0, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]

    def Xform "Decal_Line_Straight"
    {
        custom string userProperties:blender:object_name = "Decal_Line_Straight"

        def Mesh "Plane_094" (
            active = true
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            float3[] extent = [(-0.072000004, -2, -1.5099579e-7), (0.072000004, 2, 1.5099579e-7)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 3, 2]
            rel material:binding = </root/_materials/MI_Decal_Line>
            normal3f[] normals = [(0, 7.5497894e-8, 1), (0, 7.5497894e-8, 1), (0, 7.5497894e-8, 1), (0, 7.5497894e-8, 1)] (
                interpolation = "faceVarying"
            )
            point3f[] points = [(-0.072000004, -2, 1.5099579e-7), (0.072000004, -2, 1.5099579e-7), (-0.072000004, 2, -1.5099579e-7), (0.072000004, 2, -1.5099579e-7)]
            texCoord2f[] primvars:st = [(0.47236776, 0.07045436), (0.5035861, 0.07045436), (0.47236776, 0.937629), (0.5035861, 0.937629)] (
                interpolation = "faceVarying"
            )
            int[] primvars:st:indices = [0, 1, 3, 2]
            uniform token subdivisionScheme = "none"
            custom string userProperties:blender:data_name = "Plane.094"
        }
    }

    def Scope "_materials"
    {
        def Material "MI_Decal_Line"
        {
            token outputs:surface.connect = </root/_materials/MI_Decal_Line/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "MI_Decal_Line"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor = (0.80010176, 0.18927902, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.5
                float inputs:specular = 0.5
                token outputs:surface
            }
        }
    }
}

