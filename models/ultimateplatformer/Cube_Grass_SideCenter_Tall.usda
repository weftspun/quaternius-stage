            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [2, 1, 0, 11, 3, 10, 9, 4, 6, 5, 8, 7, 5, 4, 9, 8, 3, 2, 11, 10, 6, 7, 12, 13]
