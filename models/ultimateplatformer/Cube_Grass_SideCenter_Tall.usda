                uniform token familyName = "materialBind"
                int[] indices = [0, 3]
                rel material:binding = </root/_materials/Dirt_3>
            }
        }
    }

    def Scope "_materials"
    {
        def Material "Green_Light"
        {
            token outputs:surface.connect = </root/_materials/Green_Light/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Green_Light"

