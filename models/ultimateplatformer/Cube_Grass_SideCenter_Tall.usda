            point3f[] points = [(0.99999994, -0.99999994, -1), (-0.99999994, -0.99999994, -1), (-0.99999994, -0.99999994, -0.6239889), (-0.99999994, -0.99999994, -0.3276684), (-0.99999994, -0.99999994, -0.024297606), (-0.99999994, -0.99999994, 0.2812558), (-0.99999994, -0.99999994, 0.6239889), (0.99999994, -0.99999994, 0.6239889), (0.99999994, -0.99999994, 0.2812558), (0.99999994, -0.99999994, -0.024297606), (0.99999994, -0.99999994, -0.3276684), (0.99999994, -0.99999994, -0.6239889), (0.99999994, -0.99999994, 1), (-0.99999994, -0.99999994, 1)]
            uniform token subdivisionScheme = "none"
            uniform token subsetFamily:materialBind:familyType = "nonOverlapping"
            custom string userProperties:blender:data_name = "Cube.385"

