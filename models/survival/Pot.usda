    def Scope "_materials"
    {
        def Material "Black"
        {
            token outputs:surface.connect = </root/_materials/Black/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Black"

            def Shader "Principled_BSDF"
