    def Scope "_materials"
    {
        def Material "Bark_NormalTree"
        {
            token outputs:surface.connect = </root/_materials/Bark_NormalTree/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Bark_NormalTree"

            def Shader "Principled_BSDF"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.03
                color3f inputs:diffuseColor.connect = </root/_materials/Bark_NormalTree/Image_Texture.outputs:rgb>
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </root/_materials/Bark_NormalTree/Image_Texture_001.outputs:rgb>
                float inputs:opacity = 1
                float inputs:roughness = 1
                float inputs:specular = 0.5
                token outputs:surface
            }

            def Shader "Image_Texture"
            {
                uniform token info:id = "UsdUVTexture"
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </root/_materials/Bark_NormalTree/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "uvmap"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Image_Texture_001"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, -1)
                float4 inputs:scale = (2, 2, 2, 2)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </root/_materials/Bark_NormalTree/uvmap.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Leaves_Pine"
        {
            token outputs:surface.connect = </root/_materials/Leaves_Pine/Principled_BSDF.outputs:surface>
            custom string userProperties:blender:data_name = "Leaves_Pine"

